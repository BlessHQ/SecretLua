-- Format Numbers (1234 -> 1,234)
local function FormatNumber(num)
    local formatted = tostring(math.floor(tonumber(num) or 0))
    while true do
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

-- Web & Roblox Image Asset Loader
local function LoadAsset(asset)
    if not asset or asset == "" then return "" end
    if typeof(asset) == "number" then return "rbxassetid://" .. tostring(asset) end
    if asset:sub(1, 13) == "rbxassetid://" or asset:sub(1, 11) == "rbxthumb://" then return asset end
    if asset:sub(1, 4) == "http" and writefile and getcustomasset then
        local cleanName = "PN_Asset_" .. string.gsub(asset, "%W", ""):sub(-30) .. ".png"
        if not isfile(cleanName) then
            local ok, raw = pcall(function() return game:HttpGet(asset) end)
            if ok and raw and #raw > 0 then
                pcall(function() writefile(cleanName, raw) end)
            end
        end
        if isfile(cleanName) then
            return getcustomasset(cleanName)
        end
    end
    return asset
end

-- Jnkie.com Key Validation Engine
local function VerifyJnkieKey(userKey)
    if not Config.Jnkie or not Config.Jnkie.Enabled then return false end
    local apiKey = Config.Jnkie.ApiKey or ""
    local serviceId = Config.Jnkie.ServiceId or ""
    
    local url = string.format("https://api.jnkie.com/v1/keys/verify?key=%s&service=%s&apiKey=%s", 
        HttpService:UrlEncode(userKey), 
        HttpService:UrlEncode(serviceId), 
        HttpService:UrlEncode(apiKey)
    )
    
    local success, response = pcall(function()
        return game:HttpGet(url)
    end)
    
    if success and response then
        local ok, data = pcall(function() return HttpService:JSONDecode(response) end)
        if ok and data then
            return data.valid == true or data.success == true or data.status == "valid"
        end
    end
    return false
end

-- Extract Discord Invite
local function ExtractInviteCode(str)
    if not str then return "" end
    str = str:split("?")[1]:split("#")[1]
    return str:match("discord%.gg/([%w%-]+)") or str:match("discord%.com/invite/([%w%-]+)") or str:match("^([%w%-]+)$") or ""
end

