SubmitKeyButton.MouseButton1Click:Connect(function()
    local userEnteredKey = InputKeyTextBox.Text
    SubmitKeyButton.Text = "Verifying..."
    
    task.spawn(function()
        task.wait()
        local isKeyValid = false
        
        if (not Config.RequiredKey or Config.RequiredKey == "") or userEnteredKey == Config.RequiredKey then
            isKeyValid = true
        elseif Config.Jnkie and Config.Jnkie.Enabled then
            isKeyValid = VerifyJnkieKeyService(userEnteredKey)
        end
        
        if isKeyValid then
            SubmitKeyButton.Text = "Loading Script..."
            local targetScriptUrl = Config.Scripts and Config.Scripts[game.PlaceId]
            if targetScriptUrl then
                UnloadInterface()
                pcall(function()
                    loadstring(game:HttpGet(targetScriptUrl))()
                end)
            else
                InputKeyTextBox.Text = "Game script missing!"
                SubmitKeyButton.Text = "Submit Key"
                task.wait(2)
                InputKeyTextBox.Text = ""
            end
        else
            InputKeyTextBox.Text = "Invalid License Key!"
            SubmitKeyButton.Text = "Submit Key"
            task.wait(1.5)
            InputKeyTextBox.Text = ""
        end
    end)
end)
