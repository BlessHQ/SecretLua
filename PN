                DiscordCommunityTitle.Text = parsedGuildData.guild.name or DiscordCommunityTitle.Text
                
                if parsedGuildData.guild.id and parsedGuildData.guild.icon then
                    local discordCdnIconUrl = string.format("https://cdn.discordapp.com/icons/%s/%s.png?size=128", parsedGuildData.guild.id, parsedGuildData.guild.icon)
                    ApplyImage(DiscordAvatarIcon, discordCdnIconUrl, SafeFallbackIcon)
                end
                
                local onlineCount = parsedGuildData.approximate_presence_count or 0
                local totalCount = parsedGuildData.approximate_member_count or 0
                local offlineCount = math.max(0, totalCount - onlineCount)
                
                OnlineMembersLabel.Text = "● " .. FormatNumber(onlineCount) .. " Online"
                OfflineMembersLabel.Text = "● " .. FormatNumber(offlineCount) .. " Offline"
                TotalMembersLabel.Text = "Total Members: " .. FormatNumber(totalCount)
            end
        end)
    end
end)

