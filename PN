local function FormatNumber(value)
    local formatted = tostring(math.floor(tonumber(value) or 0))
    while true do
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

-- Fixed Image Caching Engine: Handles Web URLs, Discord Icons, and Roblox Assets Safely
local function ApplyImage(targetElement, targetUrl, fallbackAsset)
    targetElement.Image = fallbackAsset or SafeFallbackIcon
    if not targetUrl or targetUrl == "" then return end
    
    if targetUrl:find("rbxassetid://") or targetUrl:find("rbxthumb://") then
        targetElement.Image = targetUrl
        return
    end
    
    if targetUrl:find("http") then
        task.spawn(function()
            local assetLoadedSuccessfully = false
            pcall(function()
                if writefile and getcustomasset and isfile and readfile then
                    local sanitizedFileName = "PN_AssetCache_" .. string.gsub(targetUrl, "%W", ""):sub(-16) .. ".png"
                    if not isfile(sanitizedFileName) then
                        local rawWebData = game:HttpGet(targetUrl)
                        if rawWebData and #rawWebData > 0 then
                            writefile(sanitizedFileName, rawWebData)
                        end
                    end
                    if isfile(sanitizedFileName) then
                        targetElement.Image = getcustomasset(sanitizedFileName)
                        assetLoadedSuccessfully = true
                    end
                end
            end)
            
            if not assetLoadedSuccessfully then
                pcall(function()
                    targetElement.Image = targetUrl
                end)
            end
        end)
    end
end

local function VerifyJnkieKeyService(userKeyInput)
    if not Config.Jnkie or not Config.Jnkie.Enabled then return false end
    local endpointUrl = string.format("https://jnkie.com/api/v1/verify?key=%s&service=%s&api_key=%s", 
        HttpService:UrlEncode(userKeyInput), 
        HttpService:UrlEncode(Config.Jnkie.ServiceId or ""), 
        HttpService:UrlEncode(Config.Jnkie.ApiKey or "")
    )
    local success, responseBody = pcall(function()
        return game:HttpGet(endpointUrl)
    end)
    if success and responseBody then
        local decodeSuccess, decodedData = pcall(function()
            return HttpService:JSONDecode(responseBody)
        end)
        if decodeSuccess and decodedData then
            return decodedData.status == "valid" or decodedData.success == true
        end
    end
    return false
end

