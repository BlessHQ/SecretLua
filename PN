-- Format numbers with commas (e.g., 1234 -> "1,234")
local function FormatNumber(num)
    local formatted = tostring(math.floor(tonumber(num) or 0))
    while true do
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

-- Web & Roblox Image Asset Loader
local function LoadAsset(asset)
    if not asset or asset == "" then return "" end
    if typeof(asset) == "number" then
        return "rbxassetid://" .. tostring(asset)
    end
    if asset:sub(1, 13) == "rbxassetid://" or asset:sub(1, 11) == "rbxthumb://" then
        return asset
    end
    if asset:sub(1, 4) == "http" and writefile and getcustomasset then
        local cleanName = "PN_Asset_" .. string.gsub(asset, "%W", ""):sub(-30) .. ".png"
        if not isfile(cleanName) then
            local ok, raw = pcall(function() return game:HttpGet(asset) end)
            if ok and raw and #raw > 0 then
                pcall(function() writefile(cleanName, raw) end)
            end
        end
        if isfile(cleanName) then
            return getcustomasset(cleanName)
        end
    end
    return asset
end

-- Extract clean Discord Invite Code
local function ExtractInviteCode(str)
    if not str then return "" end
    str = str:split("?")[1]:split("#")[1]
    local code = str:match("discord%.gg/([%w%-]+)") 
        or str:match("discord%.com/invite/([%w%-]+)") 
        or str:match("discordapp%.com/invite/([%w%-]+)")
        or str:match("^([%w%-]+)$")
    return code or ""
end

