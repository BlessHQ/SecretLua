-- Format Numbers
local function FormatNumber(num)
    local formatted = tostring(math.floor(tonumber(num) or 0))
    while true do
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

-- Safely Load Images (Prevents crashes on executors without getcustomasset)
local function LoadAsset(asset)
    if not asset or asset == "" then return SafeFallbackIcon end
    if typeof(asset) == "number" then return "rbxassetid://" .. tostring(asset) end
    if asset:find("rbxassetid://") or asset:find("rbxthumb://") then return asset end
    if asset:find("http") then
        if writefile and getcustomasset and isfile then
            local cleanName = "PN_Asset_" .. string.gsub(asset, "%W", ""):sub(-15) .. ".png"
            local success = pcall(function()
                if not isfile(cleanName) then
                    local raw = game:HttpGet(asset)
                    if raw then writefile(cleanName, raw) end
                end
            end)
            if success and isfile(cleanName) then
                local assetSuccess, customAsset = pcall(function() return getcustomasset(cleanName) end)
                if assetSuccess and customAsset then return customAsset end
            end
        end
    end
    return SafeFallbackIcon
end

-- Safe Jnkie Validation
local function VerifyJnkieKey(userKey)
    if not Config.Jnkie or not Config.Jnkie.Enabled then return false end
    local apiKey = Config.Jnkie.ApiKey or ""
    local serviceId = Config.Jnkie.ServiceId or ""
    
    local url = string.format("https://jnkie.com/api/v1/verify?key=%s&service=%s&api_key=%s", 
        HttpService:UrlEncode(userKey), 
        HttpService:UrlEncode(serviceId), 
        HttpService:UrlEncode(apiKey)
    )
    
    local success, response = pcall(function() return game:HttpGet(url) end)
    if success and response then
        local ok, data = pcall(function() return HttpService:JSONDecode(response) end)
        if ok and data then
            return data.status == "valid" or data.success == true
        end
    end
    return false
end

-- Discord Info Extraction
local DiscordData = { Name = "ProjectNear Community", Icon = "", Online = 0, Offline = 0, Total = 0 }
local inviteCode = ""
pcall(function()
    local str = Config.DiscordInvite or ""
    str = str:split("?")[1]:split("#")[1]
    inviteCode = str:match("discord%.gg/([%w%-]+)") or str:match("discord%.com/invite/([%w%-]+)") or str:match("^([%w%-]+)$") or ""
end)

if inviteCode ~= "" then
    pcall(function()
        local rawJson = game:HttpGet("https://discord.com/api/v10/invites/" .. inviteCode .. "?with_counts=true")
        local data = HttpService:JSONDecode(rawJson)
        if data and data.guild then
            DiscordData.Name = data.guild.name or DiscordData.Name
            if data.guild.id and data.guild.icon then
                DiscordData.Icon = string.format("https://cdn.discordapp.com/icons/%s/%s.png?size=128", data.guild.id, data.guild.icon)
            end
            DiscordData.Online = data.approximate_presence_count or 0
            DiscordData.Total = data.approximate_member_count or 0
            DiscordData.Offline = math.max(0, DiscordData.Total - DiscordData.Online)
        end
    end)
end

