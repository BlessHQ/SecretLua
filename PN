-- Utility: Format Numbers
local function FormatNumber(num)
    local formatted = tostring(math.floor(tonumber(num) or 0))
    while true do
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

-- Utility: Asynchronous Image Loader (Prevents Freezing)
local function ApplyImage(uiElement, url, fallback)
    uiElement.Image = fallback or SafeFallbackIcon
    if not url or url == "" then return end
    if url:find("rbxassetid://") or url:find("rbxthumb://") then
        uiElement.Image = url
        return
    end
    if url:find("http") then
        task.spawn(function()
            if writefile and getcustomasset and isfile then
                local cleanName = "PN_Asset_" .. string.gsub(url, "%W", ""):sub(-15) .. ".png"
                pcall(function()
                    if not isfile(cleanName) then
                        local raw = game:HttpGet(url)
                        if raw then writefile(cleanName, raw) end
                    end
                    if isfile(cleanName) then
                        uiElement.Image = getcustomasset(cleanName)
                    end
                end)
            end
        end)
    end
end

-- Utility: Jnkie Verification
local function VerifyJnkieKey(userKey)
    if not Config.Jnkie or not Config.Jnkie.Enabled then return false end
    local url = string.format("https://jnkie.com/api/v1/verify?key=%s&service=%s&api_key=%s", 
        HttpService:UrlEncode(userKey), 
        HttpService:UrlEncode(Config.Jnkie.ServiceId or ""), 
        HttpService:UrlEncode(Config.Jnkie.ApiKey or "")
    )
    local success, response = pcall(function() return game:HttpGet(url) end)
    if success and response then
        local ok, data = pcall(function() return HttpService:JSONDecode(response) end)
        if ok and data then
            return data.status == "valid" or data.success == true
        end
    end
    return false
end

