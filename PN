    if inputKey == Config.RequiredKey or Config.RequiredKey == "" then
        SubmitBtn.Text = "Loading..."
        
        local scriptUrl = Config.Scripts[game.PlaceId]
        if scriptUrl then
            ScreenGui:Destroy()
            pcall(function()
                loadstring(game:HttpGet(scriptUrl))()
            end)
        else
            KeyBox.Text = "Game not supported!"
            SubmitBtn.Text = "Submit"
            task.wait(2)
            KeyBox.Text = ""
        end
    else
        KeyBox.Text = "Invalid Key!"
        task.wait(1.5)
        KeyBox.Text = ""
    end
end)
